# Server
HOST=127.0.0.1
PORT=8000
POLL_INTERVAL_SECONDS=0.5
WINDOW_SECONDS=60

# Meter 1: Multicomp Pro MP730889
METER1_NAME=MP730889
METER1_DRIVER=serial
METER1_IDENTIFIER=/dev/serial/by-id/REPLACE_WITH_METER1_ID
METER1_BAUDRATE=115200
METER1_INITIAL_MODE=voltage
METER1_MODE_SYNC_INTERVAL_SECONDS=5
METER1_VOLTAGE_READ_COMMAND=MEAS?
METER1_CURRENT_READ_COMMAND=MEAS:CURR?
METER1_RESISTANCE_READ_COMMAND=MEAS:RES?
METER1_TEMPERATURE_READ_COMMAND=MEAS:TEMP?
METER1_FREQUENCY_READ_COMMAND=MEAS:FREQ?
METER1_CAPACITANCE_READ_COMMAND=MEAS:CAP?
METER1_READ_MODE_COMMAND=
METER1_MODE_VOLTAGE_TOKENS=volt,vdc,voltage
METER1_MODE_CURRENT_TOKENS=curr,adc,current,amp
METER1_MODE_RESISTANCE_TOKENS=ohm,res,resistance
METER1_MODE_TEMPERATURE_TOKENS=temp,temperature
METER1_MODE_FREQUENCY_TOKENS=freq,frequency,hz
METER1_MODE_CAPACITANCE_TOKENS=cap,capacitance,farad
METER1_SET_MODE_VOLTAGE_COMMAND=
METER1_SET_MODE_CURRENT_COMMAND=
METER1_SET_MODE_RESISTANCE_COMMAND=
METER1_SET_MODE_TEMPERATURE_COMMAND=
METER1_SET_MODE_FREQUENCY_COMMAND=
METER1_SET_MODE_CAPACITANCE_COMMAND=

# Meter 2: Multicomp Pro MP730027
METER2_NAME=MP730027
METER2_DRIVER=visa
METER2_IDENTIFIER=USB0::0x5345::0x1234::REPLACE_WITH_SERIAL::INSTR
METER2_BAUDRATE=115200
METER2_INITIAL_MODE=voltage
METER2_MODE_SYNC_INTERVAL_SECONDS=0
METER2_VOLTAGE_READ_COMMAND=MEAS?
METER2_CURRENT_READ_COMMAND=MEAS:CURR?
METER2_RESISTANCE_READ_COMMAND=MEAS:RES?
METER2_TEMPERATURE_READ_COMMAND=MEAS1?
METER2_FREQUENCY_READ_COMMAND=MEAS:FREQ?
METER2_CAPACITANCE_READ_COMMAND=MEAS:CAP?
METER2_READ_MODE_COMMAND=FUNC?
METER2_MODE_VOLTAGE_TOKENS=volt,vdc,voltage
METER2_MODE_CURRENT_TOKENS=curr,adc,current,amp
METER2_MODE_RESISTANCE_TOKENS=ohm,res,resistance
METER2_MODE_TEMPERATURE_TOKENS=temp,temperature
METER2_MODE_FREQUENCY_TOKENS=freq,frequency,hz
METER2_MODE_CAPACITANCE_TOKENS=cap,capacitance,farad
METER2_SET_MODE_VOLTAGE_COMMAND=FUNC "VOLT"
METER2_SET_MODE_CURRENT_COMMAND=FUNC "CURR"
METER2_SET_MODE_RESISTANCE_COMMAND=FUNC "RES"
METER2_SET_MODE_TEMPERATURE_COMMAND=FUNC "TEMP"
METER2_SET_MODE_FREQUENCY_COMMAND=FUNC "FREQ"
METER2_SET_MODE_CAPACITANCE_COMMAND=FUNC "CAP"
METER2_TEMPERATURE_DISPLAY_COMMAND=SENS:TEMP:RTD:SHOW TEMP
METER2_TEMPERATURE_UNIT_COMMAND=SENS:TEMP:RTD:UNIT C

# Driver values: serial | visa
# - serial: METER*_IDENTIFIER should be a serial port path (e.g., /dev/ttyUSB0)
# - visa:   METER*_IDENTIFIER should be a VISA resource (e.g., USB0::0x1234::0x5678::INSTR)

# Programmable power source: Multicomp Pro 72-2540
POWER_SOURCE_NAME=Multicomp Pro 72-2540
POWER_SOURCE_ENABLED=1
POWER_SOURCE_DRIVER=visa
POWER_SOURCE_IDENTIFIER=USB0::0x1AB1::0x0E11::REPLACE_WITH_SERIAL::INSTR
POWER_SOURCE_BAUDRATE=9600
POWER_SOURCE_MEASURE_VOLTAGE_COMMAND=MEAS:VOLT?
POWER_SOURCE_MEASURE_CURRENT_COMMAND=MEAS:CURR?
POWER_SOURCE_READ_SET_VOLTAGE_COMMAND=VOLT?
POWER_SOURCE_READ_SET_CURRENT_COMMAND=CURR?
POWER_SOURCE_SET_VOLTAGE_COMMAND=VOLT {value}
POWER_SOURCE_SET_CURRENT_COMMAND=CURR {value}
POWER_SOURCE_READ_OUTPUT_ENABLED_COMMAND=OUTP?
POWER_SOURCE_SET_OUTPUT_ENABLED_COMMAND=OUTP {state}
